page {
  background: linear-gradient(180deg, #EFFAFF 0%, #F8FCFF 52%, #FFFFFF 100%);
  background-color: #F4FAFF;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
}

.card {
  background: rgba(255,255,255,0.96);
  border: 1rpx solid rgba(183,232,255,0.78);
  border-radius: 14rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 10rpx 28rpx rgba(37,99,235,0.08);
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  margin-right: 10rpx;
  margin-bottom: 8rpx;
}
.tag-orange { background: #E0F7FF; color: #38BDF8; }

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  color: #CCCCCC;
}
.empty-state text { font-size: 28rpx; margin-top: 20rpx; }