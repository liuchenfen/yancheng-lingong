<view class="page">
  <view class="list-header">
    <text class="header-title">便民信息</text>
    <text class="header-sub">附近生活信息 · 实时更新</text>
  </view>

  <view wx:if="{{errorTip}}" class="error-tip">{{errorTip}}</view>

  <view wx:if="{{!loading && list.length === 0}}" class="empty-state">
    <text class="empty-icon">无</text>
    <text class="empty-title">暂无便民信息</text>
    <text class="empty-tip">快来发布第一条便民信息吧</text>
  </view>

  <view class="convenience-list">
    <view class="info-card" wx:for="{{list}}" wx:key="id" bindtap="onCardTap" data-id="{{item.id}}">
      <view class="card-cover">
        <image
          wx:if="{{item.images.length > 0}}"
          class="cover-img"
          src="{{item.localCover || item.images[0]}}"
          mode="aspectFill"
          catchtap="previewImage"
          data-url="{{item.localCover || item.images[0]}}"
          data-urls="{{item.images}}"
          binderror="onImageError"
          data-index="{{index}}"
        />
        <view wx:else class="cover-placeholder">
          <text class="placeholder-icon">图</text>
          <text class="placeholder-text">暂无图片</text>
        </view>
      </view>

      <view class="card-main">
        <view class="card-top">
          <view class="tag-row">
            <text class="tag category-tag">{{item.category}}</text>
            <text class="tag area-tag">{{item.area}}</text>
          </view>
          <text class="card-title">{{item.content}}</text>
        </view>

        <view class="card-bottom">
          <text class="view-count">{{item.viewCount}}浏览</text>
          <text class="post-time">{{item.timeText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{loading && list.length > 0}}" class="load-more">加载中...</view>
  <view wx:if="{{!hasMore && list.length > 0}}" class="load-more">已经到底了</view>
</view>
