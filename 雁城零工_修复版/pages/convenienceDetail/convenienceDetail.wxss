.detail-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 160rpx;
  background: #f4faff;
  color: #0f172a;
}

.state-tip {
  padding-top: 240rpx;
  text-align: center;
  color: #64748b;
  font-size: 28rpx;
}

.state-tip.error {
  padding-top: 200rpx;
}

.state-tip text {
  display: block;
  margin-bottom: 24rpx;
}

.loading-dot {
  width: 48rpx;
  height: 48rpx;
  margin: 0 auto 24rpx;
  border: 4rpx solid #e2e8f0;
  border-top-color: #38bdf8;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.reload-btn {
  display: inline-block;
  padding: 14rpx 36rpx;
  border-radius: 8rpx;
  background: #38bdf8;
  color: #ffffff;
  font-size: 28rpx;
}

.detail-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.06);
}

.detail-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.5;
  color: #0f172a;
  margin-bottom: 24rpx;
}

.meta-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.meta-label {
  width: 120rpx;
  font-size: 28rpx;
  color: #94a3b8;
  flex-shrink: 0;
}

.meta-value {
  flex: 1;
  font-size: 28rpx;
  color: #334155;
}

.detail-desc {
  margin-top: 28rpx;
  font-size: 30rpx;
  line-height: 1.75;
  color: #334155;
  white-space: pre-wrap;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 28rpx;
}

.detail-image {
  width: 100%;
  height: 208rpx;
  border-radius: 12rpx;
  background: #e2e8f0;
}

.contact-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f1f5f9;
}

.contact-info {
  display: flex;
  align-items: center;
}

.contact-label {
  font-size: 28rpx;
  color: #64748b;
}

.contact-name {
  font-size: 30rpx;
  color: #0f172a;
  font-weight: 500;
}

.call-mini-btn {
  padding: 10rpx 22rpx;
  border-radius: 8rpx;
  background: #38bdf8;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 1;
}

.address-row {
  display: flex;
  align-items: flex-start;
  margin-top: 24rpx;
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 12rpx;
}

.address-icon {
  font-size: 32rpx;
  color: #22c55e;
  margin-right: 12rpx;
  line-height: 1.4;
}

.address-text {
  flex: 1;
  font-size: 28rpx;
  color: #475569;
  line-height: 1.5;
}

.stats-row {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f1f5f9;
}

.stat-item {
  display: flex;
  align-items: center;
  margin-right: 32rpx;
  color: #64748b;
  font-size: 26rpx;
}

.stat-icon {
  margin-right: 6rpx;
  font-size: 26rpx;
}

.post-time {
  margin-left: auto;
  font-size: 26rpx;
  color: #94a3b8;
}

.report-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 28rpx 32rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.06);
}

.report-text {
  font-size: 28rpx;
  color: #38bdf8;
}

.report-btn {
  padding: 10rpx 22rpx;
  border-radius: 8rpx;
  background: #38bdf8;
  color: #ffffff;
  font-size: 26rpx;
}

.report-btn.disabled {
  opacity: 0.66;
}

.warning-banner {
  margin-top: 24rpx;
  padding: 24rpx 32rpx;
  border-radius: 16rpx;
  background: #ffedd5;
  color: #ea580c;
  font-size: 26rpx;
  line-height: 1.6;
}

.float-actions {
  position: fixed;
  right: 24rpx;
  bottom: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  z-index: 100;
}

.float-btn-wrapper {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  margin-top: 16rpx;
}

.float-btn-share-hidden {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  opacity: 0;
  z-index: 2;
}

.float-btn-share-hidden::after {
  border: none;
}

.float-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #64748b;
  font-size: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.12);
  line-height: 1.2;
  padding: 0;
  overflow: hidden;
}

.float-btn::after {
  border: none;
}

.float-actions > .float-btn {
  margin-top: 16rpx;
}

.float-btn.active {
  color: #f59e0b;
}

.float-icon-img {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 4rpx;
  display: block;
}

.share-btn {
  background: #38bdf8;
  color: #ffffff;
}
