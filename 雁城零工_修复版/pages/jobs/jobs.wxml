<view class="page">
  <view class="search-bar">
    <view class="search-wrap">
      <text class="s-icon">搜</text>
      <input class="s-input" placeholder="搜索零工/公司" placeholder-class="s-placeholder" value="{{searchValue}}" bindinput="onSearchInput" bindconfirm="onSearch" confirm-type="search" />
      <view wx:if="{{searchValue}}" class="clear-btn" bindtap="onClearSearch">×</view>
      <view class="s-btn" bindtap="onSearch">搜索</view>
    </view>
  </view>

  <view class="filter-panel">
    <scroll-view scroll-x class="cat-scroll">
      <view class="cat-list">
        <view class="cat-item {{activeCategory === item ? 'cat-active' : ''}}" wx:for="{{categories}}" wx:key="*this" bindtap="onCategoryTap" data-name="{{item}}">{{item}}</view>
      </view>
    </scroll-view>
    <view class="filter-divider"></view>
    <scroll-view scroll-x class="filter-scroll">
      <view class="filter-row">
        <view class="filter-label">薪资</view>
        <view class="filter-tag {{activeSalary === item ? 'filter-active' : ''}}" wx:for="{{salaryOptions}}" wx:key="*this" bindtap="onSalaryTap" data-val="{{item}}">{{item}}</view>
      </view>
    </scroll-view>
    <scroll-view scroll-x class="filter-scroll">
      <view class="filter-row">
        <view class="filter-label">时间</view>
        <view class="filter-tag {{activeTime === item ? 'filter-active' : ''}}" wx:for="{{timeOptions}}" wx:key="*this" bindtap="onTimeTap" data-val="{{item}}">{{item}}</view>
      </view>
    </scroll-view>
  </view>

  <view class="job-list">
    <view wx:if="{{connectionTip}}" class="connection-tip">{{connectionTip}}</view>
    <view class="result-summary" wx:if="{{!loading}}">
      <text>{{filteredList.length}} 个岗位</text>
      <text wx:if="{{hasActiveFilter}}" class="reset-link" bindtap="resetFilters">重置筛选</text>
    </view>
    <view wx:if="{{loading}}" class="loading-card">
      <view class="loading-line strong"></view>
      <view class="loading-line"></view>
      <view class="loading-tags">
        <view></view>
        <view></view>
        <view></view>
      </view>
    </view>
    <view wx:if="{{!loading && filteredList.length === 0}}" class="empty-state">
      <text class="empty-icon">空</text>
      <text class="empty-title">暂无相关岗位</text>
      <text class="empty-tip">换个关键词或筛选条件试试</text>
      <view class="empty-action" bindtap="resetFilters">重置条件</view>
    </view>
    <view wx:if="{{!loading}}" class="job-card" wx:for="{{filteredList}}" wx:key="id" bindtap="onJobTap" data-id="{{item.id}}">
      <view class="job-header">
        <view class="job-info">
          <view class="job-title-row">
            <text class="job-title">{{item.title}}</text>
            <view wx:if="{{item.hot}}" class="hot-badge">热</view>
          </view>
          <text class="job-company">{{item.company}}</text>
        </view>
        <view class="job-salary-wrap">
          <text class="job-salary">{{item.salary}}</text>
        </view>
      </view>
      <view class="job-tags">
        <text class="tag tag-orange" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
      </view>
      <view class="job-footer">
        <view class="job-meta">
          <text class="job-location">{{item.displayLocation}}</text>
          <text class="meta-dot"></text>
          <text class="job-exp">{{item.experience}}</text>
        </view>
        <text class="job-time">{{item.time}}</text>
        <text class="job-arrow">></text>
      </view>
    </view>
  </view>
</view>
