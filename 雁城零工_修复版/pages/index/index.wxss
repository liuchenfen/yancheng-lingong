/* 便民信息查询入口：固定在底部导航栏上方，用 auto 高度不遮挡其他元素 */
.convenience-section {
  position: fixed;
  left: 30rpx;
  right: 30rpx;
  bottom: 0;
  margin: 0;
  padding: 0 0 16rpx;
  background: linear-gradient(to top, rgba(255,255,255,0.95) 60%, rgba(255,255,255,0));
  pointer-events: auto;
}

.convenience-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 18rpx;
  background: #4A90E2;
  box-shadow: 0 8rpx 20rpx rgba(74, 144, 226, 0.28);
}

.convenience-text {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

/* 推荐岗位向上滚动轮播 */
.recommend-section { overflow: hidden; }
.recommend-viewport {
  position: relative;
  max-height: 360rpx;
  overflow: hidden;
  border-radius: 16rpx;
}
.recommend-track {
  display: flex;
  flex-direction: column;
  /* 不使用 will-change，真机上会导致动画层被 GPU 缓存后停止更新 */
  animation-name: scrollUp;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
  animation-fill-mode: none;
  /* 默认暂停，由 JS 控制 anim-playing 类来启动 */
  animation-play-state: paused;
}
.recommend-track.anim-playing {
  animation-play-state: running;
}
.recommend-track.anim-paused {
  animation-play-state: paused;
}
@keyframes scrollUp {
  0%   { transform: translateY(0); }
  100% { transform: translateY(-50%); }
}
.empty-recommend { padding: 40rpx; text-align: center; }
.empty-text { color: #BBBBBB; font-size: 26rpx; }

