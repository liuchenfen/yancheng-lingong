.icon-build .part-b, .icon-build .part-c { animation: iconLift 2.4s ease-in-out .2s infinite; }
.icon-homecare .part-a, .icon-homecare .part-b, .icon-homecare .part-c { animation: iconHeartbeat 2s ease-in-out infinite; transform-origin: 50% 55%; }
.icon-more { animation: iconMoreSpin 3.2s ease-in-out infinite; transform-origin: 50% 50%; }
.icon-more .part-c { animation: iconSpark 1.9s ease-in-out infinite; }
@keyframes iconLift { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5rpx); } }
@keyframes iconStrap { 0%, 100% { transform: translateY(0) scaleY(1); opacity: .55; } 50% { transform: translateY(-5rpx) scaleY(.78); opacity: .82; } }
@keyframes iconSteam { 0% { transform: translateY(8rpx) scaleY(.78); opacity: .25; } 50% { transform: translateY(-3rpx) scaleY(1.08); opacity: .95; } 100% { transform: translateY(-10rpx) scaleY(.72); opacity: .2; } }
@keyframes iconBagPop { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.08); } }
@keyframes iconSpark { 0%, 100% { transform: scale(.72); opacity: .32; } 50% { transform: scale(1.18); opacity: .95; } }
@keyframes iconSweep { 0%, 100% { transform: rotate(22deg); } 50% { transform: rotate(54deg); } }
@keyframes iconCruise { 0%, 100% { transform: translateX(-2rpx); } 50% { transform: translateX(4rpx); } }
@keyframes iconWheel { 0% { transform: translateX(0) scale(.82); opacity: .52; } 50% { transform: translateX(0) scale(1.08); opacity: .9; } 100% { transform: translateX(0) scale(.82); opacity: .52; } }
@keyframes iconHammer { 0%, 100% { transform: rotate(12deg); } 50% { transform: rotate(34deg); } }
@keyframes iconHeartbeat { 0%, 100% { transform: scale(1); } 35% { transform: scale(1.1); } 55% { transform: scale(.96); } }
@keyframes iconMoreSpin { 0%, 100% { transform: rotate(0deg) scale(1); } 50% { transform: rotate(90deg) scale(1.08); } }
